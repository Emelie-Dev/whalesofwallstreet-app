# Server Configuration
PORT=8080

# Database Configuration
# Format: postgres://[user[:password]@][host][:port][/database]
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wow_engine

# Request Signature Verification
# Hex-encoded 32-byte Ed25519 public key used to verify Ed25519 signatures on
# incoming requests (X-Signature + X-Timestamp headers). When set, every route
# except the public allowlist (/api/v1/health, /api/v1/quote) requires a valid
# signature over "{METHOD}\n{PATH}\n{UNIX_TIMESTAMP}\n{SHA256_HEX(body)}".
# Leave unset to DISABLE verification (local dev only) — a startup warning is logged.
# SIGNING_PUBLIC_KEY=

# Request Timeout
# Upper bound, in seconds, on how long any single HTTP request may run before
# the server aborts it and returns 408 Request Timeout.
# REQUEST_TIMEOUT_SECS=30

# Redis (cluster-wide cache invalidation)
# When set, enables pub/sub-based cache invalidation across multiple engine
# nodes. Leave unset for single-node deployments (local dev).
# REDIS_URL=redis://localhost:6379

# Ethereum RPC
# JSON-RPC endpoint used to read Circle CCTP attester keys on-chain.
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# CCTP Configuration
# Address of Circle's MessageTransmitter contract on the source chain.
# CCTP_MESSAGE_TRANSMITTER=0x0a992d191deec32afe36203ad87d7d289a738f81
# Path to the append-only log recording consumed CCTP nonces.
# CCTP_NONCE_STORE_PATH=data/cctp_consumed_nonces.log

# Gas Oracle – Etherscan API Key
# API key for authenticated Etherscan gas-tracker requests. When set, appended
# as &apikey=<key> to the Etherscan gastracker endpoint to avoid rate-limiting.
# Obtain a free key at https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=

# Gas Oracle – Arbiscan API Key
# API key for authenticated Arbiscan gas-tracker requests.
# Obtain a free key at https://arbiscan.io/myapikey
# ARBISCAN_API_KEY=

# Anchor Domain Allowlist
# Comma-separated list of anchor domains the engine is permitted to interact
# with. When non-empty, deposit/withdraw/quote requests referencing an anchor
# domain not in this list are rejected. Leave empty to allow all domains
# (local dev only — restrict in production).
# ALLOWED_ANCHOR_DOMAINS=localhost,anchor.stellar.org

# CORS Origins
# Comma-separated list of allowed CORS origins for browser-based frontend
# calls. When non-empty, only requests from these origins are permitted.
# When empty, CORS is fully permissive (local dev mode — restrict in production).
# ALLOWED_CORS_ORIGINS=https://app.example.com,http://localhost:3000

# Logging
RUST_LOG=info,wow_engine=debug,sqlx=debug
